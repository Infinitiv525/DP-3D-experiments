FoamFile
{
    format ascii;
    class dictionary;
    object controlDict;
}
application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime __END_TIME__;
deltaT __INITIAL_DT__;
adjustTimeStep yes;
maxCo __MAX_CO_TARGET__;
maxDeltaT __MAX_DT__;
writeControl adjustableRunTime;
writeInterval __END_TIME__;
purgeWrite 1;
writeFormat binary;
writePrecision 10;
writeCompression on;
timeFormat general;
timePrecision 10;
runTimeModifiable false;

functions
{
    inletFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name inlet;
        operation sum;
        fields (phi);
        writeFields false;
        writeControl timeStep;
        writeInterval 10;
        log true;
    }
    outletFlux
    {
        $inletFlux;
        name outlet;
    }
    frontFlux
    {
        $inletFlux;
        name periodicFront;
    }
    backFlux
    {
        $inletFlux;
        name periodicBack;
    }
}
