FoamFile { format ascii; class dictionary; object fvSolution; }
solvers
{
    p
    {
        solver GAMG;
        smoother DICGaussSeidel;
        tolerance __P_TOL__;
        relTol __P_REL__;
    }
    pFinal { $p; relTol 0; }
    U
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-8;
        relTol 0.05;
    }
    UFinal { $U; relTol 0; }
}
PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors __OUTER__;
    nCorrectors __CORRECT__;
    nNonOrthogonalCorrectors __NONORTH__;
}
