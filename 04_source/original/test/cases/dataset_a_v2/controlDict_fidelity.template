FoamFile
{
    format ascii;
    class dictionary;
    object controlDict;
}
application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime __END_TIME__;
deltaT __INITIAL_DT__;
adjustTimeStep yes;
maxCo __MAX_CO__;
maxDeltaT __MAX_DT__;
writeControl adjustableRunTime;
writeInterval __WRITE_INTERVAL__;
purgeWrite 0;
writeFormat binary;
writePrecision 10;
writeCompression on;
timeFormat general;
timePrecision 12;
runTimeModifiable false;
functions
{
    inletFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name inlet;
        operation sum;
        fields (phi);
        writeFields false;
        writeControl timeStep;
        writeInterval 10;
        log false;
    }
    outletFlux { $inletFlux; name outlet; }
    frontFlux { $inletFlux; name periodicFront; }
    backFlux { $inletFlux; name periodicBack; }
    obstacleForces
    {
        type forceCoeffs;
        libs (forces);
        patches (obstacle);
        rho rhoInf;
        rhoInf 998.2;
        CofR (0 0 0);
        liftDir (0 1 0);
        dragDir (1 0 0);
        pitchAxis (0 0 1);
        magUInf 0.02375;
        lRef 0.01;
        Aref 0.0001;
        writeControl timeStep;
        writeInterval 10;
        log false;
    }
}
