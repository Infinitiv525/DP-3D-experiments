FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         80.0;
deltaT          0.001;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       0.01;
writeControl    adjustableRunTime;
writeInterval   2.0;
purgeWrite      0;
writeFormat     binary;
writePrecision  10;
writeCompression on;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;

functions
{
    forceCoefficients
    {
        type forceCoeffs;
        libs (forces);
        patches (cylinder);
        rho rhoInf;
        rhoInf 998.2;
        log true;
        CofR (0 0 0);
        liftDir (0 1 0);
        dragDir (1 0 0);
        pitchAxis (0 0 1);
        magUInf 0.02;
        lRef 0.01;
        Aref 0.0004;
        writeControl timeStep;
        writeInterval 1;
    }

    wakeProbes
    {
        type probes;
        libs (sampling);
        fields (U p);
        probeLocations
        (
            (0.015 0 0)
            (0.030 0 0)
            (0.050 0 0)
            (0.030 0.010 0.010)
        );
        writeControl timeStep;
        writeInterval 1;
    }
}
